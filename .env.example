# Copiar a .env y completar con tus valores
GEMINI_API_KEY=your_gemini_api_key_here
# Claves adicionales separadas por coma (rotación automática ante 429/quota).
# Se usa primero GEMINI_API_KEY y luego las de GEMINI_API_KEYS en orden.
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-2.5-flash

# CORS
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Carpeta de salida de exportaciones
OUTPUT_DIR=./output
