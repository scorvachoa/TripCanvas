# Copiar a .env y completar con tus valores
GEMINI_API_KEY=your_gemini_api_key_here
# Claves adicionales numeradas para rotación automática ante 429/quota.
# Se usa primero GEMINI_API_KEY y luego las numeradas en orden.
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_MODEL=gemini-2.5-flash

# Pexels (fotos automáticas del destino). Gratis en https://www.pexels.com/api/
# Si está vacía, las tarjetas se generan sin foto.
PEXELS_API_KEY=

# CORS
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Carpeta de salida de exportaciones
OUTPUT_DIR=./output

# MySQL (Aiven)
MYSQL_HOST=localhost
MYSQL_PORT=10379
MYSQL_USER=avnadmin
MYSQL_PASSWORD=
MYSQL_DB=defaultdb
# Ruta al certificado CA de Aiven (opcional). Si se define, la conexión usa SSL.
# MYSQL_SSL_CA=./certs/ca.pem
