# Copiar a .env y completar con tus valores
GEMINI_API_KEY=your_gemini_api_key_here
# Claves adicionales numeradas para rotación automática ante 429/quota.
# Se usa primero GEMINI_API_KEY y luego las numeradas en orden.
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_MODEL=gemini-2.5-flash

# Pexels (fotos automáticas del destino). Gratis en https://www.pexels.com/api/
# Si está vacía, las tarjetas se generan sin foto.
PEXELS_API_KEY=

# Tinify/TinyPNG (compresión de PNG al exportar). Gratis en
# https://tinypng.com/developers (500 compresiones/mes). Si está vacía, la
# exportación devuelve el PNG sin comprimir.
TINIFY_API_KEY=

PORT=8080

# CORS
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Carpeta de salida de exportaciones
OUTPUT_DIR=./output
